# Development defaults for a local SecureClaw stack.
# Replace these values in shared or production deployments.
P0_PORT=9001
P1_PORT=9002
EXECUTOR_PORT=9100
MIRAGE_HTTP_PORT=8765
MIRAGE_HTTP_BIND=127.0.0.1
MIRAGE_HTTP_TOKEN=secureclaw-dev-token
FSS_DOMAIN_SIZE=4096
MAX_TOKENS_PER_MESSAGE=32
DLP_MODE=dfa
SIGNED_PIR=1
POLICY0_MAC_KEY=1111111111111111111111111111111111111111111111111111111111111111
POLICY1_MAC_KEY=2222222222222222222222222222222222222222222222222222222222222222

# Optional provider credentials for agent integrations.
# Leave unset if you only run the local runtime and built-in Python demo.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# OPENCLAW_MODEL_PRIMARY=openai/gpt-4o-mini
