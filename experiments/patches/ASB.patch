+def _safe_api_error_detail(error) -> str:
+    """Return a short provider error detail without leaking credentials."""
+    detail = ""
+    response = getattr(error, "response", None)
+    if response is not None:
+        try:
+            detail = response.text
+        except Exception:
+            detail = str(response)
+    if not detail:
+        detail = str(error)
+    detail = re.sub(r"sk-or-v1-[A-Za-z0-9]+", "sk-or-v1-REDACTED", detail)
+    detail = detail.replace("\n", " ")[:500]
+    return detail
+
+
+def _normalize_openai_tools(tools):
+    """Normalize ASB's null-parameter tools to the OpenAI/OpenRouter schema."""
+    if not tools:
+        return tools
+    normalized = []
+    for tool in tools:
+        if not isinstance(tool, dict):
+            normalized.append(tool)
+            continue
+        copied = json.loads(json.dumps(tool))
+        function = copied.get("function")
+        if isinstance(function, dict) and function.get("parameters") is None:
+            function["parameters"] = {"type": "object", "properties": {}}
+        normalized.append(copied)
+    return normalized
+
