# Source after setting OPENROUTER_API_KEY in your environment.
# This file contains no credentials. Do not commit your local credentials.
export OPENAI_BASE_URL=https://openrouter.ai/api/v1
export OPENAI_API_KEY="${OPENROUTER_API_KEY}"
export SC_MODEL_TEMPERATURE=0
# Select SECURECLAW_LLM_READ_SUMMARY per benchmark as documented in README.
export SECURECLAW_TASK_CAPSULE=0
export SECURECLAW_READ_OUTPUT_MODE=sanitized_summary
export SECURECLAW_READ_SUMMARY_MAX_ITEMS=8
export SECURECLAW_READ_SUMMARY_MAX_CHARS=512
